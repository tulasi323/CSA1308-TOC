#include <stdio.h>
#include <string.h>

int main()
{
    char str[100];
    int state = 0;
    int i;

    printf("Enter a string: ");
    scanf("%s", str);

    for(i = 0; str[i] != '\0'; i++)
    {
        switch(state)
        {
            case 0:
                if(str[i] == 'a')
                    state = 1;
                else if(str[i] == 'b')
                    state = 3;
                else
                    state = -1;
                break;

            case 1:
                if(str[i] == 'c')
                    state = 2;
                else
                    state = -1;
                break;

            case 3:
                if(str[i] == 'a')
                    state = 4;
                else
                    state = -1;
                break;

            case 4:
                if(str[i] == 'c')
                    state = 5;
                else
                    state = -1;
                break;

            default:
                state = -1;
        }
    }

    if(state == 1 || state == 2 || state == 5)
        printf("String Accepted\n");
    else
        printf("String Rejected\n");

    return 0;
}
