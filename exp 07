#include <stdio.h>
#include <string.h>

int main()
{
    char s[100];
    int i, n, count0 = 0, count1 = 0;
    int flag = 1;

    printf("Enter a string: ");
    scanf("%s", s);

    n = strlen(s);

    /* Count 0s */
    i = 0;
    while(i < n && s[i] == '0')
    {
        count0++;
        i++;
    }

    /* Count 1s */
    while(i < n && s[i] == '1')
    {
        count1++;
        i++;
    }

    /* Check the string */
    if(i != n || count0 != count1)
        flag = 0;

    if(flag == 1)
        printf("String is accepted by the grammar\n");
    else
        printf("String is not accepted by the grammar\n");

    return 0;
}
