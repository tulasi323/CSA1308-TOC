#include <stdio.h>
#include <string.h>

int main()
{
    char s[100];
    int i, n, flag = 0;

    printf("Enter a string: ");
    scanf("%s", s);

    n = strlen(s);

    /* Check for 101 */
    for(i = 0; i <= n - 3; i++)
    {
        if(s[i] == '1' &&
           s[i + 1] == '0' &&
           s[i + 2] == '1')
        {
            flag = 1;
            break;
        }
    }

    if(flag == 1)
        printf("String is accepted by the grammar\n");
    else
        printf("String is not accepted by the grammar\n");

    return 0;
}
